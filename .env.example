# NeuralSight Max - Environment Configuration Example
# ==================================================
# Rename this file to .env and fill in your actual keys.
# NEVER commit your actual API keys to GitHub.

# 1. Groq API (Voice Transcription)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# 2. OpenClaude / MiniMax (Agent Brain)
# MiniMax endpoint: https://api.minimax.io/anthropic
# Get your key at: https://platform.minimaxi.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic